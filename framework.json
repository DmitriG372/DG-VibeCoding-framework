{
  "version": "9.1.0",
  "name": "DG-VibeCoding-Framework",
  "description": "Lean agent framework — one shared contract (AGENTS.md) that Claude Code and Codex both load, guardrails only where an action is irreversible",

  "core": {
    "contract": "AGENTS.md",
    "skills": [],
    "commands": [
      "done",
      "review",
      "handoff",
      "sprint"
    ],
    "agents": [
      "reviewer",
      "debugger"
    ],
    "hooks_blocking": [
      "block-env",
      "completion-guard"
    ]
  },

  "invariant": "Anything an agent must know lives in AGENTS.md. Agent-specific surfaces add convenience, never capability. The framework ships no .claude/rules, because Codex cannot read them, and no skills, because none has earned its per-session load cost. A project that adds a skill keeps one copy under .agents/skills/ (Agent Skills standard, read by Codex natively) and links .claude/skills to it, so both runtimes load the same set.",

  "paths": {
    "contract": "AGENTS.md",
    "claude_entry": "CLAUDE.md",
    "review_policy": "REVIEW.md",
    "commands": ".claude/commands/*.md",
    "agents": ".claude/agents/*.md",
    "hooks": "hooks/*.js",
    "settings_claude": ".claude/settings.local.json",
    "settings_codex": ".codex/hooks.json",
    "sprint": "sprint/sprint.json",
    "sprint_schema": "templates/sprint.schema.json",
    "headless_review": "scripts/headless-review.sh"
  },

  "agents": {
    "cc": { "config": "CLAUDE.md", "branch_prefix": "cc/" },
    "cx": { "config": "AGENTS.md", "branch_prefix": "cx/" }
  },

  "review": {
    "tool": "claude",
    "mode": "quick"
  },

  "install": {
    "entries": [
      { "from": "core/AGENTS.md", "to": "AGENTS.md" },
      { "from": "core/CLAUDE.md", "to": "CLAUDE.md" },
      { "from": "core/REVIEW.md", "to": "REVIEW.md" },
      { "from": "templates/project-init/PROJECT.md", "to": "PROJECT.md" },
      { "from": "core/settings.template.json", "to": ".claude/settings.local.json", "local": true },
      { "from": "core/codex-hooks.template.json", "to": ".codex/hooks.json" },
      { "from": "framework.json", "to": "framework.json" },
      { "from": "templates/.gitignore.template", "to": ".gitignore" },
      { "from": "templates/manifest.md.template", "to": "manifest.md", "local": true },
      { "from": "templates/sprint.schema.json", "to": "templates/sprint.schema.json" },
      { "from": "templates/sprint.template.json", "to": "templates/sprint.template.json" },
      { "from": "templates/review-output.schema.json", "to": "templates/review-output.schema.json" },
      { "from": ".claude/commands", "to": ".claude/commands" },
      { "from": ".claude/agents", "to": ".claude/agents" },
      { "from": "hooks", "to": "hooks" },
      { "from": "scripts/package.json", "to": "scripts/package.json" },
      { "from": "scripts/validate-sprint.js", "to": "scripts/validate-sprint.js", "executable": true },
      { "from": "scripts/verify-install.js", "to": "scripts/verify-install.js", "executable": true },
      { "from": "scripts/stub-check.sh", "to": "scripts/stub-check.sh", "executable": true },
      { "from": "scripts/security-scan.sh", "to": "scripts/security-scan.sh", "executable": true },
      { "from": "scripts/framework-state-mode.sh", "to": "scripts/framework-state-mode.sh", "executable": true },
      { "from": "scripts/switch-repo-access.sh", "to": "scripts/switch-repo-access.sh", "executable": true },
      { "from": "scripts/worktree-setup.sh", "to": "scripts/worktree-setup.sh", "executable": true },
      { "from": "scripts/worktree-cleanup.sh", "to": "scripts/worktree-cleanup.sh", "executable": true },
      { "from": "scripts/handoff-worktree.sh", "to": "scripts/handoff-worktree.sh", "executable": true },
      { "from": "scripts/headless-review.sh", "to": "scripts/headless-review.sh", "executable": true },
      { "from": "scripts/parse-codex-jsonl.js", "to": "scripts/parse-codex-jsonl.js", "executable": true },
      { "from": "scripts/normalize-review.js", "to": "scripts/normalize-review.js", "executable": true }
    ]
  },

  "integrations": {
    "codex": {
      "cli": true,
      "equal_partner": true
    }
  },

  "update_sources": [
    "https://code.claude.com/docs/en/memory",
    "https://code.claude.com/docs/en/best-practices",
    "https://claude.com/blog/the-ai-native-sdlc-playbook",
    "https://learn.chatgpt.com/docs/build-skills",
    "https://learn.chatgpt.com/docs/agent-configuration/agents-md",
    "https://agents.md/"
  ]
}
