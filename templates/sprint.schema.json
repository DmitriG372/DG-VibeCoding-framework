{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dg-vibecoding.dev/schemas/sprint-v4.json",
  "title": "CC/CX coordination file (v4)",
  "description": "Optional. Says who is working on what, on which branch. Nothing else.",
  "type": "object",
  "required": ["schema_version", "base_branch", "tasks"],
  "properties": {
    "schema_version": { "const": 4 },
    "base_branch": { "type": "string", "minLength": 1 },
    "updated": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "assigned_to", "status", "branch"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "assigned_to": { "enum": ["cc", "cx"] },
          "status": { "enum": ["planned", "in_progress", "in_review", "done"] },
          "branch": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
