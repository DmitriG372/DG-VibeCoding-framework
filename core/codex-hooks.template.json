{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node ./hooks/decomposition-guard.js" },
          { "type": "command", "command": "node ./hooks/test-dir-protection.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ./hooks/completion-guard.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node ./hooks/scope-guard.js" },
          { "type": "command", "command": "node ./hooks/type-check.js" },
          { "type": "command", "command": "node ./hooks/auto-format.js" },
          { "type": "command", "command": "node ./hooks/sprint-sync.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ./hooks/test-output-filter.js" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node ./hooks/pre-compact.js" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "node ./hooks/git-context.js" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node ./hooks/context-reload.js" }
        ]
      }
    ]
  }
}
