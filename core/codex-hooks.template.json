{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/block-env.js\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/completion-guard.js\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/pre-compact.js\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/git-context.js\"" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/context-reload.js\"" }
        ]
      }
    ]
  }
}
